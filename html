<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My First HTML Page</title>
    <style>
        table, th, td {
            border: 1px solid blue;
            border-collapse: collapse;
            background-color: white;
        }
    </style>
</head>
<body style="background-color: rgb(188, 97, 66);">
    <h1>My First HTML</h1>
    <p>pangit mo!</p>

    <a href="https://www.youtube.com">go to youtube</a>
    <br>
    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTjK3-4yc62gqP-hpoPXz8d14zMNNTRWJOMhBugnitqsComFSDa53sad9&s=10" 
         width="200" height="150" alt="picture ng koteng, di mo lang kita" title="ako si dogie">

    <!-- this is a formatting text -->
    <p>this is a <b>BOLD</b> text!</p>
    <p>this is a <strong>STRONG</strong> text!</p>
    <p>this is a <i>ITALIC</i> text!</p>
    <p>this is a <em>EMPHASIZE</em> text!</p>
    <p>this is a <mark>MARKED</mark> text!</p>
    <p>this is a <small>SMALL</small> text!</p>
    <p>this is a <del>DELETED</del> text!</p>
    <p>this is a <ins>INSERTED</ins> text!</p>
    <p>this is a <sub>SUBSCRIPT</sub> text!</p>
    <p>this is a <sup>SUPERSCRIPT</sup> text!</p>

    <!-- unordered list -->
    <ul>
        <li>banana</li>
        <li>papaya</li>
        <li>unana</li>
    </ul>

    <!-- ordered list -->
    <ol type="a">
        <li>padre burgos</li>
        <li>utot mo</li>
        <li>buldak</li>
    </ol>

    <!-- table in html -->
    <table>
        <tr>
            <th>name</th>
            <th>age</th>
            <th>course</th>
        </tr>
        <tr>
            <td>ken</td>
            <td>20 nako</td>
            <td>BSit po</td>
        </tr>
        <tr>
            <td>joshua</td>
            <td>20 rin</td>
            <td>BSit rin</td>
        </tr>
    </table>

    <!-- form in html -->
    <form action="">
        <label>username</label>
    </form>
</body>
</html>
